{
  "rules": {
    "convoys": {
      "$convoyId": {
        "breaches": {
          ".read": "auth != null",
          ".write": "auth != null",
          "$pairKey": {
            ".validate": "newData.hasChildren(['distanceMeters', 'triggeredAt'])"
          }
        }
      }
    },
    "ptt_sessions": {
      "$convoyId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
