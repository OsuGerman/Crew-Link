# 'development' (default), 'test', or 'production'. Hosted deployments MUST set
# NODE_ENV=production AND FIREBASE_PROJECT_ID — otherwise the server falls back to
# the insecure dev token verifier (any bearer token is accepted as a user id).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Firebase project id used to verify the app's Firebase ID tokens (the bearer
# token sent by the app). REQUIRED for any hosted/production deployment. When
# unset (local dev / tests) the bearer token is treated as the user id directly.
FIREBASE_PROJECT_ID=crew-link-3c852

# Postgres + PostGIS.
# Local: `cd infra && docker compose up -d`.
# Production: a managed Postgres with PostGIS (e.g. Supabase — connection string
# from Project Settings -> Database). Run `npm run db:migrate` once to apply the
# schema and enable the `postgis` extension.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crew_link

# Redis — horizontal WebSocket fan-out across multiple backend instances.
# OPTIONAL: a single instance works without it (the gateway falls back to an
# in-process fan-out). Production multi-instance: a managed Redis (e.g. Upstash,
# use the rediss:// URL).
REDIS_URL=redis://localhost:6379

# LiveKit — WebRTC audio SFU for Push-to-Talk (https://livekit.io; LiveKit Cloud
# has a free tier). Without these, the /ptt-token route is disabled.
LIVEKIT_URL=wss://your-livekit-host.example.com
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
